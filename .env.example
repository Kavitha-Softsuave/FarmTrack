# Copy this file to .env and fill in the values. Do not put a real key in this example file (.env is never committed).
# It lists EVERY setting the backend reads: the Settings fields of backend/app/config.py (the variable name is the upper-case
# field name) and the few variables the code reads straight from the environment. Values are safe placeholders or the code's
# defaults. A line that starts with "# NAME=" is optional; the comment above it says what happens when it is unset.
# Comments are on their own lines on purpose (some env-file readers do not strip trailing comments).
# Run from backend/: `docker compose --env-file ../.env up -d --build` (make docker-up) reads this file for the API and for
# the database password. A local run (`make run`) reads it through the application settings.

# ---------------------------------------------------------------- general
# dev | test | prod. prod refuses to start on development defaults (SECRET_KEY, ADMIN_API_KEY, CORS_ORIGINS, DEMO_DISEASE_HINTS)
# and uses Alembic migrations, no demo seeding, no API docs. Any other value (a typo such as "staging") refuses to load.
# The Docker image defaults to prod when ENV is not set, so a local demo in Docker needs ENV=dev here on purpose.
# NEVER run a server that real farmers can reach with ENV=dev: it loads the demo farmers with the public DEMO_PASSWORD.
ENV=dev
# Version string shown by /v1/meta.
APP_VERSION=0.1.0
# JWT signing key. Prod: a random value of at least 32 characters (this placeholder is too short on purpose, so prod rejects it).
SECRET_KEY=change-me
# Staff key for /admin (header X-Admin-Key, or the admin login page). Prod: a random value of at least 16 characters.
ADMIN_API_KEY=change-me
# Access token lifetime in minutes and refresh token lifetime in days.
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
# JSON list of allowed browser origins. Prod: explicit origins, or [] when only the mobile app calls the API ("*" is refused).
CORS_ORIGINS=["*"]
# Upload limits per photo (MB) and per scan, and how long stored photos are kept (days).
MAX_UPLOAD_MB=8
MAX_PHOTOS_PER_SCAN=4
PHOTO_RETENTION_DAYS=365

# ---------------------------------------------------------------- database (docker-compose.yml reads POSTGRES_*)
# Local default: a SQLite file in backend/. docker-compose builds DATABASE_URL for the API from the three POSTGRES_* values.
# DATABASE_URL=sqlite:///./farmtrack.db
# DATABASE_URL=postgresql+psycopg://farmtrack:change-me-postgres@localhost:5432/farmtrack
POSTGRES_USER=farmtrack
POSTGRES_DB=farmtrack
# Required by docker compose (it refuses to start without it). Choose your own value.
POSTGRES_PASSWORD=change-me-postgres
# Docker image: 1 (default) runs `alembic upgrade head` before the server starts; 0 skips it (several replicas: migrate once from
# the deploy step instead). Outside Docker with ENV=prod it lets the app upgrade the schema itself (one worker only).
AUTO_MIGRATE=1
# ENV=prod only: 1 also loads the 50 demo farmers into an empty database (dev and test always do).
# SEED_DEMO=0

# ---------------------------------------------------------------- paths
# Leave these unset: a local run uses ../data, ../voice and backend/storage; the Docker image sets /data, /voice, /app/storage.
# DATA_DIR=
# VOICE_DIR=
# STORAGE_DIR=

# ---------------------------------------------------------------- login (username + password; the OTP login is kept but off)
# MVP login: POST /v1/auth/login with a username and a password. An admin sets them (Admin > Farmers: "Set login" and "Create
# farmer"); passwords are stored only as salted hashes. A farmer without a login cannot log in until an admin sets one.
# The OTP login (phone + SMS code) stays in the code but its routes answer 404 unless this is true. It also needs an SMS gateway.
OTP_LOGIN_ENABLED=false
# Password of the demo farmers (usernames f001 ... f050). They exist only where the demo farmers are loaded: ENV=dev/test, or
# ENV=prod with SEED_DEMO=1. Never use the default on a server that real farmers can reach.
# DEMO_PASSWORD=farm1234
# OTP login only (OTP_LOGIN_ENABLED=true). Dev only (ignored when ENV=prod): this code is accepted for every login so no SMS is needed.
DEV_FIXED_OTP=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# SMS gateway: not wired yet. There is no SMS setting; the OTP is only logged (see docs/design-notes/platform.md before OTP is switched on).

# ---------------------------------------------------------------- demo clock and demo steering
# The demo runs on this fixed "now" (the season is Mar-Oct 2026). Empty = the real clock. Admin > Demo clock changes it live.
DEMO_CLOCK=2026-05-12T08:00:00+05:30
# ENV=prod refuses a fixed DEMO_CLOCK (and the admin cannot set one): every farmer would get the demo day's season. Leave it empty in
# production. Set to 1 only for a deliberate demo server that runs with ENV=prod.
# ALLOW_DEMO_CLOCK_IN_PROD=0
# Offline demos only (ignored by the factory and refused at start-up when ENV=prod): force the STUB disease classifier.
# Format: Crop=disease_id[:confidence];Crop=disease_id[:confidence]  (disease ids of data/reference/disease_catalogue.csv).
# DEMO_DISEASE_HINTS=Apple=Apple___Apple_scab:0.9;Tomato=Tomato___Late_blight

# ---------------------------------------------------------------- providers (the defaults run fully offline)
# mock | openai
LLM_PROVIDER=mock
# The OpenAI key: never commit it, never print it. Needed only for LLM_PROVIDER=openai or EMBEDDINGS_PROVIDER=openai.
OPENAI_API_KEY=your-openai-api-key-here
# gpt-4o-mini shuts down on 14 Jan 2027: switch to gpt-6-luna before then.
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_DETAIL=high
OPENAI_TEMPERATURE=0
OPENAI_MAX_OUTPUT_TOKENS=1200
# null | google (text to speech for the spoken advice; null = the app speaks with the phone's own voice)
TTS_PROVIDER=null
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here
TTS_VOICE_HI=hi-IN-Neural2-A
TTS_VOICE_EN=en-IN-Neural2-A
# hash (offline) | openai ; memory | pgvector (pgvector needs a PostgreSQL DATABASE_URL)
EMBEDDINGS_PROVIDER=hash
EMBEDDINGS_MODEL=text-embedding-3-small
VECTOR_STORE=memory
# stub (uses the phone's guess and the farmer's crops) | model (server models, needs `pip install -e ".[ml]"`)
CROP_ID_PROVIDER=stub
DISEASE_PROVIDER=stub
# mock | real (real is an untested skeleton: see the ZOHO_* variables below)
ZOHO_PROVIDER=mock
IOT_PROVIDER=mock
# csv (demo archive) | openmeteo (free tier is non-commercial)
WEATHER_PROVIDER=csv
# log | fcm (fcm needs `pip install -e ".[fcm]"` and the credentials file below)
PUSH_PROVIDER=log
# Firebase service-account JSON for PUSH_PROVIDER=fcm. Never commit that file.
# FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json

# ---------------------------------------------------------------- Zoho CRM and Open-Meteo key (Settings fields: the process environment and this .env file both work)
# Only for ZOHO_PROVIDER=real (self-client OAuth credentials, India data centre).
# ZOHO_CLIENT_ID=your-zoho-client-id
# ZOHO_CLIENT_SECRET=your-zoho-client-secret
# ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# ZOHO_API_BASE=https://www.zohoapis.in/crm/v6
# Optional Open-Meteo customer key (WEATHER_PROVIDER=openmeteo); without it the free endpoint is used.
# OPEN_METEO_API_KEY=your-open-meteo-key

# ---------------------------------------------------------------- alerts and rules
# Background jobs run inside the API process: alert check interval in minutes, and 0 to switch the scheduler off.
ALERT_INTERVAL_MINUTES=60
ALERT_SCHEDULER=1
# Diseases that may get medicine advice without an agronomist: comma list of disease ids, or * for all with chemical control.
# Owner decision 19 Oct 2026: * (the default). Expert-review diseases, no-cure diseases, low confidence, unknown disease and
# a disease of another crop still go to the expert. Set it EMPTY to narrow it to apple scab only.
# RULES_AUTO_ADVICE_DISEASES=*
# Season check of the rules. Owner decision 22 Oct 2026: false (development): a disease is advised on any date and the growth
# stage does not exclude products. true = production behaviour: scab only in its primary season, leaf spots from 1 June.
RULES_SEASON_CHECK=false
# Photo-confidence cut-offs (data/reference/rules_config.json wins when it defines them).
MIN_CONFIDENCE_SHOW=0.45
MIN_CONFIDENCE_ADVICE=0.65
