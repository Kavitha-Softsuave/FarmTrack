# Normalise line endings in the repository; keep scripts that must run on both systems in their native form.
* text=auto
*.sh text eol=lf
gradlew text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# binary files
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.jar binary
